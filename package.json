{
  "name": "pi-systemd",
  "version": "0.1.0",
  "description": "Run long commands as transient systemd user units from pi and read their output from the journal",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "systemd",
    "journald",
    "background",
    "transient-unit"
  ],
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.0.0",
    "typebox": "*",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "koffi": "^3.3.7"
  }
}
